<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="go-gh"
        Arguments=""
        InstallLocation="C:\Program Files\go-gh\go-gh">
    </Installer>
    <PackageInformation
        PackageName="go-gh"
        PackageDisplayName="go-gh"
        PublisherName="CN=go-gh"
        PublisherDisplayName="go-gh"
        Version="0.1.0.0"
        PackageDescription="GitHub events in your tray">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.gogh.tray"
                Description="GitHub events in your tray"
                DisplayName="go-gh"
                ExecutableName="go-gh"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>go-gh</DisplayName>
            <PublisherDisplayName>go-gh</PublisherDisplayName>
            <Description>GitHub events in your tray</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="go-gh.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
